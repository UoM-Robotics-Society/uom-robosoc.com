---
import { getCollection } from "astro:content"
import PageLayout from "@layouts/PageLayout.astro"
import ArrowCard from "@components/ArrowCard"
import StackCard from "@components/StackCard.astro"
import { SITE, SOCIALS } from "@consts"
import TwinklingStars from "@components/TwinklingStars.astro"
import MeteorShower from "@components/MeteorShower.astro"

import FAQ from '../components/FAQ.astro'

import { Image } from "astro:assets"
import brandTitle from '../assets/svgs/brand-title.svg'
import heroImage from '../assets/img/hero.jpg'

const svgs = import.meta.glob('/src/assets/svgs/*.svg', { 
  query: '?raw',
  import: 'default',
  eager: true,
});
const iconMap = Object.fromEntries(Object.entries(svgs).map(([filepath, mod]) => {
  const name = filepath.split('/').pop()?.replace('.svg', '') ?? '';
  return [name, mod];
}));

const posts = (await getCollection("blog"))
  .filter(post => !post.data.draft)
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
  .slice(0,3)

const projects = (await getCollection("projects"))
  .filter(project => project.data.featured)
  .filter(project => !project.data.draft)
  .sort((a, b) => a.data.order - b.data.order)

const stack = [
  { 
    text: "Astro", 
    icon: "astro", 
    href: "https://astro.build" 
  },
  { 
    text: "Javascript", 
    icon: "javascript", 
    href: "https://www.javascript.com" 
  },
  { 
    text: "Typescript", 
    icon: "typescript", 
    href: "https://www.typescriptlang.org" 
  },
  { 
    text: "Tailwind", 
    icon: "tailwind", 
    href: "https://tailwindcss.com" 
  },
]
