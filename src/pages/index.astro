---
import { getCollection } from "astro:content"
import PageLayout from "@layouts/PageLayout.astro"
import ArrowCard from "@components/ArrowCard"
import StackCard from "@components/StackCard.astro"
import { SITE, SOCIALS } from "@consts"
import TwinklingStars from "@components/TwinklingStars.astro"
import MeteorShower from "@components/MeteorShower.astro"

import FAQ from '../components/FAQ.astro'

import { Image } from "astro:assets"
import brandTitle from '../assets/svgs/brand-title.svg'
import heroImage from '../assets/img/hero.jpg'

const svgs = import.meta.glob('/src/assets/svgs/*.svg', { 
  query: '?raw',
  import: 'default',
  eager: true,
});
const iconMap = Object.fromEntries(Object.entries(svgs).map(([filepath, mod]) => {
  const name = filepath.split('/').pop()?.replace('.svg', '') ?? '';
  return [name, mod];
}));

const posts = (await getCollection("blog"))
  .filter(post => !post.data.draft)
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
  .slice(0,3)

const projects = (await getCollection("projects"))
  .filter(project => project.data.featured)
  .filter(project => !project.data.draft)
  .sort((a, b) => a.data.order - b.data.order)

const stack = [
  { 
    text: "Astro", 
    icon: "astro", 
    href: "https://astro.build" 
  },
  { 
    text: "Javascript", 
    icon: "javascript", 
    href: "https://www.javascript.com" 
  },
  { 
    text: "Typescript", 
    icon: "typescript", 
    href: "https://www.typescriptlang.org" 
  },
  { 
    text: "Tailwind", 
    icon: "tailwind", 
    href: "https://tailwindcss.com" 
  },
]
---

<PageLayout title="Home" description={SITE.DESCRIPTION}>

  <!-- HERO -->
  <section class="relative h-screen w-full">
    <div class="animate absolute h-full w-full flex items-center justify-center">

      <Image
          src={heroImage}
          alt="View of the Makerspace"
          loading="eager"
          fetchpriority="high"
          decoding="sync"
          quality={35}
          class="absolute w-full h-full object-cover object-center"
          />
      <div class="absolute inset-0 bg-black/50 backdrop-brightness-75"></div>

      <div class='relative w-full h-full flex items-center justify-center'>
        <div class='p-5 text-center text-white'>
          <p class='animated text-lg md:text-xl lg:text-2xl font-semibold'>
            Hi! We are
          </p>
          <div class="py-3 animated flex flex-col items-center">
            <Image src={brandTitle} alt="Robosoc" class="h-10 w-auto"/>
          </div>
          <p class='pt-1 animated text-sm md:text-base lg:text-lg'>
            University of Manchester Robotics Society
          </p>
          <p class='animated text-sm md:text-base lg:text-lg pt-8'>
          Weekly projects every Wednesday @ 2pm during Term Time</p>
          <p>
          Nancy Rothwell Building
          </p>

          <div class="pt-8 flex items-center justify-center text-sm gap-1">

            <a href="/projects" class="h-8 rounded-full px-3 text-current  flex items-center justify-center  transition-colors duration-300 ease-in-out  bg-black dark:bg-white text-white dark:text-black  hover:bg-black/5 dark:hover:bg-white/80">
              See our projects
            </a>

            <a href="/join" class="h-8 rounded-full px-3 text-current  flex items-center justify-center  transition-colors duration-300 ease-in-out  border  hover:bg-black/5 dark:hover:bg-white/20 hover:text-black dark:hover:text-white">
              Join us
            </a>

          </div>
        </div>
      </div>
    </div>
  </section>
